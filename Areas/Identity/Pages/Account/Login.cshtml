@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-container py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 mx-auto">
                <div class="card glass-card shadow-lg rounded-4 border-0">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <h1 class="font"> Iniciar sesión </h1>
                            <p class="text-muted">Accede a tu cuenta para continuar</p>
                        </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-floating mb-4 input-group-hover">
                            <input asp-for="Input.Email" class="form-control custom-input" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                                <label asp-for="Input.Email">✉️ <class="form-label"> Correo electrónico </label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-4 input-group-hover">
                            <input asp-for="Input.Password" class="form-control custom-input" autocomplete="current-password" aria-required="true" placeholder="contraseña" />
                                <label asp-for="Input.Password">🔑 <class="form-label"> Contraseña </label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label" asp-for="Input.RememberMe">Recordarme </label>
                            </div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none hover-link">¿Olvidaste tu contraseña?</a>
                        </div>

                        <button id="login-submit" type="submit" class="btn btn-primary w-100 py-3 mb-4 btn-hover">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
                        </button>

                        <div class="text-center">
                            <p>¿No tienes una cuenta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold hover-link">Regístrate aquí</a></p>
                            <p><a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-decoration-none hover-link">Reenviar correo de confirmación</a></p>
                        </div>
                    </form>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="my-4">
                            <div class="separator text-muted d-flex align-items-center my-3">
                                <span class="line flex-grow-1"></span>
                                <span class="mx-2">o continúa con</span>
                                <span class="line flex-grow-1"></span>
                            </div>

                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-flex gap-3 flex-wrap justify-content-center">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-secondary social-btn" name="provider" value="@provider.Name" title="Iniciar sesión con tu cuenta de @provider.DisplayName">
                                        @provider.DisplayName
                                    </button>
                                }
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        /* estilos de fuentes */
        .font {
            font-family: 'Plom';
            src: url('/Fonts/PlomPraeng.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-size: 3rem;
        }

        /* Mantenemos la aplicación de la fuente como la tenías */
        #account,
        #account label,
        #account input,
        #account button,
        #account p,
        #account a {
            font-size: 1.5rem;
            font-family: 'Plom', sans-serif !important;
        }

        /* Asegurémonos que estos tamaños de fuente sean responsivos */
        @@media (max-width: 768px) {
            #account,
            #account label,
            #account input,
            #account button,
            #account p,
            #account a {
                font-size: 1.2rem;
            }
            
            .font {
                font-size: 2.5rem;
            }
        }

        .form-control,
        .btn-primary {
            font-size: 1.2rem;
        }

        /* Nuevos estilos modernos */
        body {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            background-attachment: fixed;
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            width: 100%;
            max-width: 100%;
            padding: 2rem;
        }

        /* Efecto de vidrio esmerilado para la tarjeta */
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(31, 38, 135, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.18);
            transition: all 0.4s ease;
            width: 100%;
            margin: 0 auto;
        }
            .glass-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 30px rgba(31, 38, 135, 0.4);
            }

        /* Estilo para inputs */
        .custom-input {
            border-radius: 10px;
            border: 2px solid #e0e0e0;
            padding: 12px;
            transition: all 0.3s;
        }

        .input-group-hover:hover .custom-input {
            border-color: #2575fc;
        }

        .custom-input:focus {
            border-color: #6a11cb;
            box-shadow: 0 0 0 0.25rem rgba(106, 17, 203, 0.25);
        }

        /* Botón principal con animación */
        .btn-primary {
            background: linear-gradient(45deg, #6a11cb, #2575fc);
            border: none;
            border-radius: 10px;
            font-weight: 500;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 15px rgba(37, 117, 252, 0.4);
            transition: all 0.3s;
        }

        .btn-hover:hover {
            background: linear-gradient(45deg, #5900b3, #1a66e0);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(37, 117, 252, 0.5);
        }

        .btn-hover:active {
            transform: translateY(0);
        }

        /* Efecto para enlaces */
        .hover-link {
            background-image: linear-gradient(90deg, #6a11cb, #2575fc);
            background-size: 0% 2px;
            background-repeat: no-repeat;
            background-position: left bottom;
            transition: background-size 0.3s ease;
            padding-bottom: 2px;
        }

            .hover-link:hover {
                background-size: 100% 2px;
                color: #6a11cb;
            }

        /* Estilo para botones sociales */
        .social-btn {
            border-radius: 10px;
            padding: 10px 20px;
            transition: all 0.3s;
            background: white;
            border: 2px solid #e0e0e0;
        }

            .social-btn:hover {
                background: #f8f9fa;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
                border-color: #2575fc;
            }

        .separator {
            width: 100%;
        }

            .separator .line {
                height: 2px;
                background: linear-gradient(90deg, transparent, rgba(106, 17, 203, 0.5), transparent);
            }


        .fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .card {
            animation: fadeIn 0.8s ease forwards;
        }
    </style>
}