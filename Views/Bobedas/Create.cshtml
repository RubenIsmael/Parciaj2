@model San_Agustin_Final.Models.Bobeda
@{
    ViewData["Title"] = "Crear Bóveda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!--  Enlace a Font Awesome para iconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
<link rel="stylesheet" href="~/css/admi.css" />

<!--  Contenedor fluido con diseño más moderno 
<div class="container-fluid bg-light">-->
    <div class="row justify-content-center">
        <div class="col-md-6">
            <!--  Tarjeta con sombra y diseño más profundo -->
            <div class="card shadow-lg border-0 rounded-lg mt-5">
                <!--  Encabezado con gradiente de color -->
                <div class="card-header bg-primary text-white text-center"
                     style="background: linear-gradient(to right, #4a90e2, #50c878);">
                    <h1 class="my-2">Registrar Nueva Bóveda</h1>
                </div>

                <!--  Cuerpo de la tarjeta con más espaciado -->
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!--  Divicion -->
                    <div class="form-group mb-3">
                        <label asp-for="Division" class="form-label text-primary">
                            <i class="fas fa-building me-2"></i>División
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-primary text-white">
                                <i class="fas fa-building"></i>
                            </span>
                            <select asp-for="Division" class="form-control">
                                <option value="">Seleccione una división</option>
                                @if (ViewBag.TiposBobeda != null)
                                {
                                    @foreach (var tipo in (IEnumerable<SelectListItem>)ViewBag.TiposBobeda)
                                    {
                                        <option value="@tipo.Value">@tipo.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <span asp-validation-for="Division" class="text-danger"></span>
                    </div>

                        <!--  arriendo propietario libre -->
                        <div class="form-group mb-3">
                            <label asp-for="Estado" class="form-label text-primary">
                                <i class="fas fa-check-circle me-2"></i>Estado
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-primary text-white">
                                    <i class="fas fa-check-circle"></i>
                                </span>
                                <select asp-for="Estado" class="form-control">
                                    <option value="">Seleccione un estado</option>
                                <option value="libre">Libre</option>
                                <option value="arriendo">Arriendo</option>
                                <option value="propietario">Propietario</option>
                                </select>
                            </div>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>

                        <!--  Botones con estilos más modernos -->
                        <div class="form-group text-center mt-4">
                            <button type="submit" class="btn btn-modern btn-crear me-2">
                                <i class="fas fa-save me-2"></i>Guardar
                            </button>
                            <a asp-action="Index" class="btn btn-modern btn-detalles">
                                <i class="fas fa-arrow-left me-2"></i>Volver al Listado
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}