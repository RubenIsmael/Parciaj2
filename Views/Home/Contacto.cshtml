@model San_Agustin_Final.Models.Mensajes

@{
    ViewBag.Title = "Contacto";
}

<div class="container-fluid py-5 contact-container plom-font">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <h1 class="text-center mb-5 contact-title">Contacto</h1>
            
            <link rel="stylesheet" href="~/css/contacto.css" />
            <link rel="stylesheet" href="~/css/site.css" />

            <div class="row">
                <!-- Formulario de contacto -->
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <div class="contact-form-card">
                        <h2 class="contact-subtitle mb-4">Envíanos un mensaje</h2>

                        <form asp-action="EnviarMensaje" method="post" id="contactForm">
                            <div class="form-group mb-3">
                                <label asp-for="NombreCompleto" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    <input type="text" class="form-control" asp-for="NombreCompleto" placeholder="Tu nombre completo">
                                </div>
                                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="CorreoElectronico" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    <input type="email" class="form-control" asp-for="CorreoElectronico" placeholder="tu@email.com">
                                </div>
                                <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Telefono" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                    <input type="tel" class="form-control" asp-for="Telefono" placeholder="Tu número de teléfono">
                                </div>
                                <span asp-validation-for="Telefono" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Mensaje" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-comment-alt"></i></span>
                                    <textarea class="form-control" asp-for="Mensaje" rows="5" placeholder="¿En qué podemos ayudarte?"></textarea>
                                </div>
                                <span asp-validation-for="Mensaje" class="text-danger"></span>
                            </div>
                            <div class="text-center">
                                <button type="submit" class="modern-btn" onclick="return showAlert();">
                                    Enviar Mensaje
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

                <!-- Información de contacto y chat -->
                <div class="col-lg-6">
                    <div class="contact-info-card mb-4">
                        <h2 class="contact-subtitle mb-4">Información de Contacto</h2>

                        <div class="contact-info-item mb-3">
                            <div class="contact-info-icon">
                                <i class="fas fa-phone-alt"></i>
                            </div>
                            <div class="contact-info-text">
                                <h3>Teléfono</h3>
                                <p><a href="tel:(123) 456-7890">(+593) 993498432 </a></p>
                            </div>
                        </div>

                        <div class="contact-info-item mb-3">
                            <div class="contact-info-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="contact-info-text">
                                <h3>Correo Electrónico</h3>
                                <p><a href="mailto:administracion@sanagustin.com">administracion@sanagustin.com</a></p>
                            </div>
                        </div>

                        <div class="contact-info-item mb-3">
                            <div class="contact-info-icon">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="contact-info-text">
                                <h3>Dirección</h3>
                                <p>Av. E20 y Mario Cedeño Vera, La Concordia</p>
                            </div>
                        </div>

                        <div class="contact-info-item mb-3">
                            <div class="contact-info-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="contact-info-text">
                                <h2>Horario de Atención</h2>
                                <p>Lunes a vienes: 8:00 AM - 6:00 PM</p>
                                <p>

                                </p>
                                <h3>Fines de Semana</h3>
                                <p> 9:00 AM - 4:00 PM</p>
                                <p>

                                </p>
                                <h3>Feriadosa</h3>
                                <p> 11:00 AM - 6:00 PM</p>
                            </div>
                        </div>
                    </div>                                      
                </div>
            </div>
            <!-- Mapa de ubicación -->
            <div class="row mt-5">
                <div class="col-12">
                    <div class="contact-map-card">
                        <h2 class="contact-subtitle mb-4">Nuestra Ubicación</h2>
                        <div class="map-container">
                            <!-- Google Maps iframe -->
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.8183024937166!2d-79.38579886190186!3d-0.005419675395572691!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x902aaaae9f05796f%3A0xf8934d42d2080719!2sCampo%20santo%20San%20Agust%C3%ADn!5e0!3m2!1ses!2sec!4v1742487135562!5m2!1ses!2sec" 
                                    width="100%"
                                    height="300"
                                    style="border:0;"
                                    allowfullscreen=""
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                        <div class="share-location mt-3 text-center">
                            <a href="https://wa.me/?text=Visítanos en nuestra ubicación: https://maps.app.goo.gl/mhptX3qXWsQRSyD38"
                               target="_blank"
                               class="modern-btn share-btn">
                                Compartir ubicación por WhatsApp
                                <i class="fab fa-whatsapp"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
                    </div>
                </div>
            </div>
<!-- Chatbot -->
<div class="chatbot-trigger" id="chatTrigger">
    <i class="fas fa-comment-dots"></i>
</div>

<!-- Chatbot Contenido -->
<div class="chat-container" id="chatContainer" style="display: none;">
    <div class="chat-header">
        <h4 class="mb-0"><i></i>🤖 Asistente Virtual</h4>
        <button class="chat-close" id="chatClose">&times;</button>
    </div>
    <div class="chat-body" id="chatBody">
        <!-- mensajes predeterminados-->
    </div>
    <div class="chat-suggestions">
        <button class="suggestion-btn">¿Hay bóvedas disponibles?</button>
        <button class="suggestion-btn">¿Cómo hacer una reserva?</button>
        <button class="suggestion-btn">Consultar pagos pendientes</button>
        <button class="suggestion-btn">Horario de atención</button>
    </div>
    <div class="chat-input">
        <input type="text" id="chatInput" placeholder="Escribe tu mensaje...">
        <button id="sendBtn">
            <i class="fas fa-paper-plane"></i>
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/contacto.js"></script>

    <script>
         function showAlert() {
            alert('Mensaje enviado correctamente. Gracias por contactarnos.');
            return true; // Permitir que el formulario se envíe
        }

        $(document).ready(function () {
            // Animación para los elementos de la página
            $('.contact-form-card, .contact-info-card, .contact-chat-card, .contact-map-card').addClass('fade-in');

            // Validación del formulario
            $('#contactForm').submit(function (e) {
                e.preventDefault();
                alert('Mensaje enviado correctamente. Gracias por contactarnos.');
            });
        });
    </script>
}