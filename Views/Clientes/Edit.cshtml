@model San_Agustin_Final.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Enlace a Font Awesome para iconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
<link rel="stylesheet" href="~/css/admi.css" />

<div class="row justify-content-center">
    <div class="col-md-6">
        <!-- Tarjeta con sombra y diseño más profundo -->
        <div class="card shadow-lg border-0 rounded-lg mt-5">
            <!-- Encabezado con gradiente de color -->
            <div class="card-header bg-primary text-white text-center"
                 style="background: linear-gradient(to right, #4a90e2, #50c878);">
                <h1 class="my-2">Modificar Cliente</h1>
            </div>

            <!-- Cuerpo de la tarjeta con más espaciado -->
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <!-- Resumen de validación -->
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <!-- Grupo de formulario para Cedula -->
                    <div class="form-group mb-3">
                        <label asp-for="Clave" class="form-label text-primary">
                            <i class="fas fa-lock me-2"></i>Cédula
                        </label>
                        <input asp-for="Clave" class="form-control" placeholder="Ingrese la cedula" readonly />
                        <span asp-validation-for="Clave" class="text-danger"></span>
                    </div>

                    <!-- Grupo de formulario para Nombres -->
                    <div class="form-group mb-3">
                        <label asp-for="Nombres" class="form-label text-primary">
                            <i class="fas fa-user me-2"></i>Nombres
                        </label>
                        <input asp-for="Nombres" class="form-control" placeholder="Ingrese los nombres" />
                        <span asp-validation-for="Nombres" class="text-danger"></span>
                    </div>

                    <!-- Grupo de formulario para Apellidos -->
                    <div class="form-group mb-3">
                        <label asp-for="Apellidos" class="form-label text-primary">
                            <i class="fas fa-user me-2"></i>Apellidos
                        </label>
                        <input asp-for="Apellidos" class="form-control" placeholder="Ingrese los apellidos" />
                        <span asp-validation-for="Apellidos" class="text-danger"></span>
                    </div>

               

                    <!-- Grupo de formulario para Correo -->
                    <div class="form-group mb-3">
                        <label asp-for="Correo" class="form-label text-primary">
                            <i class="fas fa-envelope me-2"></i>Correo
                        </label>
                        <input asp-for="Correo" class="form-control" placeholder="Ingrese el correo" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                                    <!-- Botones con estilos más modernos -->
                    <div class="form-group text-center mt-4">
                        <button type="submit" class="btn btn-modern btn-crear me-2">
                            <i class="fas fa-save me-2"></i>Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-modern btn-detalles">
                            <i class="fas fa-arrow-left me-2"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}