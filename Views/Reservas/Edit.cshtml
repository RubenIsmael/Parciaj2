@model San_Agustin_Final.Models.Reserva

@{
    ViewData["Title"] = "Modificar Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Enlace a Font Awesome para iconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
<link rel="stylesheet" href="~/css/admi.css" />

<div class="row justify-content-center">
    <div class="col-md-6">
        <!-- Tarjeta con sombra y diseño más profundo -->
        <div class="card shadow-lg border-0 rounded-lg mt-5">
            <!-- Encabezado con gradiente de color -->
            <div class="card-header bg-primary text-white text-center"
                 style="background: linear-gradient(to right, #4a90e2, #50c878);">
                <h1 class="my-2">Modificar Reserva</h1>
            </div>

            <!-- Cuerpo de la tarjeta con más espaciado -->
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <!-- Resumen de validación -->
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <!-- Grupo de formulario para IdCliente -->
                    <div class="form-group mb-3">
                        <label asp-for="IdCliente" class="form-label text-primary">
                            <i class="fas fa-user me-2"></i>ID Cliente
                        </label>
                        <input asp-for="IdCliente" class="form-control" />
                        <span asp-validation-for="IdCliente" class="text-danger"></span>
                    </div>

                    <!-- Grupo de formulario para Nombre -->
                    <div class="form-group mb-3">
                        <label asp-for="Nombre" class="form-label text-primary">
                            <i class="fas fa-user-tag me-2"></i>Nombre
                        </label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <!-- Grupo de formulario para Apellido -->
                    <div class="form-group mb-3">
                        <label asp-for="Apellido" class="form-label text-primary">
                            <i class="fas fa-user-tag me-2"></i>Apellido
                        </label>
                        <input asp-for="Apellido" class="form-control" />
                        <span asp-validation-for="Apellido" class="text-danger"></span>
                    </div>

                    <!-- Grupo de formulario para IdPrecio (Sector) -->
                    <div class="form-group mb-3">
                        <label asp-for="IdPrecio" class="form-label text-primary">
                            <i class="fas fa-tags me-2"></i>Sector
                        </label>
                        <select asp-for="IdPrecio" class="form-control" asp-items="ViewBag.Sector"></select>
                        <span asp-validation-for="IdPrecio" class="text-danger"></span>
                    </div>

                    <!-- Grupo de formulario para PrecioValor -->
                    <div class="form-group mb-3">
                        <label asp-for="IdPrecio" class="form-label text-primary">
                            <i class="fas fa-dollar-sign me-2"></i>Precio
                        </label>
                        <select asp-for="IdPrecio" class="form-control" asp-items="ViewBag.PrecioValor"></select>
                        <span asp-validation-for="IdPrecio" class="text-danger"></span>
                    </div>

                    <!-- Grupo de formulario para EstadoPago -->
                    <div class="form-group mb-3">
                        <label asp-for="EstadoPago" class="form-label text-primary">
                            <i class="fas fa-check-circle me-2"></i>Estado de Pago
                        </label>
                        <input asp-for="EstadoPago" class="form-control" />
                        <span asp-validation-for="EstadoPago" class="text-danger"></span>
                    </div>

                    <!-- Grupo de formulario para FechaReserva -->
                    <div class="form-group mb-3">
                        <label asp-for="FechaReserva" class="form-label text-primary">
                            <i class="fas fa-calendar-alt me-2"></i>Fecha de Reserva
                        </label>
                        <input asp-for="FechaReserva" class="form-control" />
                        <span asp-validation-for="FechaReserva" class="text-danger"></span>
                    </div>

                    <!-- Botones con estilos más modernos -->
                    <div class="form-group text-center mt-4">
                        <button type="submit" class="btn btn-modern btn-crear me-2">
                            <i class="fas fa-save me-2"></i>Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-modern btn-detalles">
                            <i class="fas fa-arrow-left me-2"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}