@model San_Agustin_Final.Models.Precio

@{
    ViewData["Title"] = "Crear Precio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Enlace a Font Awesome para iconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
<link rel="stylesheet" href="~/css/admi.css" />

<div class="row justify-content-center">
    <div class="col-md-6">
        <!-- Tarjeta con sombra y diseño más profundo -->
        <div class="card shadow-lg border-0 rounded-lg mt-5">
            <!-- Encabezado con gradiente de color -->
            <div class="card-header bg-primary text-white text-center"
                 style="background: linear-gradient(to right, #4a90e2, #50c878);">
                <h1 class="my-2">Registrar Nuevo Precio</h1>
            </div>

            <!-- Cuerpo de la tarjeta con más espaciado -->
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Grupo de formulario para Sector -->
                    <div class="form-group mb-3">
                        <label asp-for="Sector" class="form-label text-primary">
                            <i class="fas fa-map-signs me-2"></i>Sector
                        </label>
                        <select asp-for="Sector" class="form-control" asp-items="ViewBag.Sectores">
                            @if (ViewBag.TiposBobeda != null)
                            {
                                @foreach (var tipo in (IEnumerable<SelectListItem>)ViewBag.TiposBobeda)
                                {
                                    <option value="@tipo.Value">@tipo.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Sector" class="text-danger"></span>
                    </div>

                   
                    <!-- Grupo de formulario para PrecioValor -->
                    <div class="form-group mb-3">
                        <label asp-for="PrecioValor" class="form-label text-primary">
                            <i class="fas fa-dollar-sign me-2"></i>Precio
                        </label>
                        <input asp-for="PrecioValor" class="form-control" />
                        <span asp-validation-for="PrecioValor" class="text-danger"></span>
                    </div>

                    <!-- Botones con estilos más modernos -->
                    <div class="form-group text-center mt-4">
                        <button type="submit" class="btn btn-modern btn-crear me-2">
                            <i class="fas fa-save me-2"></i>Crear
                        </button>
                        <a asp-action="Index" class="btn btn-modern btn-detalles">
                            <i class="fas fa-arrow-left me-2"></i>Volver a la lista
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}