@model IEnumerable<San_Agustin_Final.Models.Dashboard>

@{
    ViewData["Title"] = "Dashboard Analicis";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header mb-4">
        <h1 class="text-primary" data-aos="fade-right">Dashboard de Análisis</h1>
        <p class="lead" data-aos="fade-right" data-aos-delay="100">
            Seleccione una pregunta para visualizar información relevante
        </p>
    </div>

    <!--Question Selection Section-->
    <div class="card shadow mb-4" data-aos="fade-up">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-question-circle me-2"></i>Seleccione una Pregunta
            </h5>
        </div>
        <div class="card-body">
            <select id="questionSelector" class="form-select form-select-lg mb-3">
                <option value="" selected disabled>Seleccione una pregunta...</option>
                <optgroup label="Reservas y Clientes">
                    <option value="reservas-periodo">¿Cuántas reservas se han realizado por mes?</option>
                    <option value="estado-reservas">¿Cuál es el estado de las reservas?</option>
                    <option value="clientes-reservas">¿Cuántos clientes han realizado reservas?</option>
                    <option value="promedio-cliente">¿Cuál es el promedio de reservas por cliente?</option>
                </optgroup>
                <optgroup label="Pagos">
                    <option value="ingresos-periodo">¿Cuál es el total de ingresos por mes?</option>
                    <option value="pagos-promedio">¿Cuántos pagos se han realizado y cuál es su monto promedio?</option>
                </optgroup>
                <optgroup label="Bóvedas y Precios">
                    <option value="bobedas-estado">¿Cuántas bóvedas están disponibles, ocupadas y libres?</option>
                    <option value="precio-promedio">¿Cuál es el precio promedio por tipo de bóveda?</option>
                    <option value="bobeda-demanda">¿Qué tipo de bóveda tiene la mayor demanda?</option>
                </optgroup>
                <optgroup label="Mensajes">
                    <option value="mensajes-estado">¿Cuántos mensajes han sido recibidos y leídos?</option>
                </optgroup>
                <optgroup label="Análisis General">
                    <option value="tendencias-tiempo">¿Cuáles son las tendencias de reservas y pagos?</option>
                    <option value="meses-actividad">¿Qué meses tienen la mayor actividad?</option>
                </optgroup>
            </select>

            <div class="date-filters mt-3">
                <div class="row">
                    <div class="col-md-5">
                        <label for="startDate" class="form-label">Fecha Inicio:</label>
                        <input type="date" id="startDate" class="form-control" value="2025-01-01">
                    </div>
                    <div class="col-md-5">
                        <label for="endDate" class="form-label">Fecha Fin:</label>
                        <input type="date" id="endDate" class="form-control" value="2025-12-31">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button id="applyFilters" class="btn btn-primary w-100">
                            <i class="fas fa-filter me-2"></i>Aplicar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Cards Section -->
    <div class="row mb-4" id="kpiCards" data-aos="fade-up" data-aos-delay="200">
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow kpi-card">
                <div class="card-body text-center">
                    <h5 class="card-title text-muted" id="kpi1Title">KPI Principal</h5>
                    <h2 class="display-4 fw-bold text-primary" id="kpi1Value">--</h2>
                    <p class="card-text text-muted" id="kpi1Desc">Seleccione una pregunta</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow kpi-card">
                <div class="card-body text-center">
                    <h5 class="card-title text-muted" id="kpi2Title">KPI Secundario</h5>
                    <h2 class="display-4 fw-bold text-success" id="kpi2Value">--</h2>
                    <p class="card-text text-muted" id="kpi2Desc">Seleccione una pregunta</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow kpi-card">
                <div class="card-body text-center">
                    <h5 class="card-title text-muted" id="kpi3Title">KPI Terciario</h5>
                    <h2 class="display-4 fw-bold text-danger" id="kpi3Value">--</h2>
                    <p class="card-text text
                    <p class="card-text text-muted" id="kpi3Desc">Seleccione una pregunta</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart Section -->
    <div class="row" data-aos="fade-up" data-aos-delay="300">
        <div class="col-md-8 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0" id="chartTitle"><i class="fas fa-chart-bar me-2"></i>Gráfico Principal</h5>
                </div>
                <div class="card-body">
                    <div id="mainChart" style="height: 400px;"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0" id="secondaryChartTitle"><i class="fas fa-chart-pie me-2"></i>Gráfico Secundario</h5>
                </div>
                <div class="card-body">
                    <div id="secondaryChart" style="height: 400px;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Section -->
    <div class="card shadow mb-4" data-aos="fade-up" data-aos-delay="400">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="fas fa-table me-2"></i>Datos Detallados</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%">
                    <thead class="table-light">
                        <tr id="tableHeader">
                            <th>Categoría</th>
                            <th>Valor</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="2" class="text-center">Seleccione una pregunta para ver datos detallados</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Loading overlay -->
<div id="loadingOverlay" class="loading-overlay d-none">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
    <div class="mt-2">Cargando datos...</div>
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- ApexCharts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <!-- CountUp.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/countup.js/2.0.0/countUp.min.js"></script>

    <!-- Custom Scripts -->
    <script src="~/js/reportes.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/reportes.css">
}