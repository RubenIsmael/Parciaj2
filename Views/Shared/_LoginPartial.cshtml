@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="modern-btn asp-area="Identity" data-aos="fade-left" asp-page="/Account/Manage/Index" title="Administrar">Hola @User.Identity?.Name!</a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" data-aos="fade-left" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="modern-green-btn">Cerrar sesión</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="modern-green-btn" data-aos="fade-right" asp-area="Identity" asp-page="/Account/Register">Registrarse</a>
        </li>
        <li class="nav-item">
            <a class="modern-btn" data-aos="fade-right" href="/Identity/Account/Login">
                Iniciar<i class="fas fa-sign-in-alt"></i>
            </a>
        </li>
    }
</ul>