<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cementerio San Agustín</title>


    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- bot CSS -->
    <link rel="stylesheet" href="~/css/chatbot.css" />
    <!-- Bot js -->
    <script src="~/js/chatbot.js" defer></script>
    <!-- AOS Animaciones -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />


    <!-- Hoja de estilos personalizada -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Sección para estilos específicos de vistas -->
    @await RenderSectionAsync("Styles", required: false)

    <style>
        @@font -face {
            font-family: 'Plom';
            src: url('../Fonts/PlomPraeng.ttf') format('truetype');
        }

        body {
            padding-top: 100px;
            font-family: 'Plom', sans-serif;
        }
    </style>
</head>
<body>
    <header>
        <!-- Navbar -->
        <nav class="navbar navbar-expand-sm navbar-light bg-white fixed-top shadow-sm">
            <div class="container-fluid">
                <!-- Logo (comentado)
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.jpeg" alt="Logo" class="logo-img" style="height: 100px; width: auto;">
                </a>-->
                <!-- Botón móvil -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menú -->
                <div class="collapse navbar-collapse" id="navbarMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <!-- Elementos visibles solo cuando el usuario NO está autenticado -->
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item" data-aos="fade-left">
                                <a class="nav-link menu-link" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>
                            <li class="nav-item" data-aos="fade-left">
                                <a class="nav-link menu-link" asp-controller="Home" asp-action="Quienes">¿Quiénes somos?</a>
                            </li>
                            <li class="nav-item" data-aos="fade-left">
                                <a class="nav-link menu-link" asp-controller="Home" asp-action="Contacto">Contacto</a>
                            </li>
                            <li class="nav-item" data-aos="fade-left">
                                <a class="nav-link menu-link" asp-controller="Home" asp-action="Aporte">Aporte a la Comunidad</a>
                            </li>
                        }

                        <!-- Elementos visibles solo cuando el usuario está autenticado -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="TipoBobedas" asp-action="Index">División</a>
                                </li>
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="Bobedas" asp-action="Index">Bóvedas</a>
                                </li>
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="Clientes" asp-action="Index">Clientes</a>
                                </li>
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="Contratoes" asp-action="Index">Contratos</a>
                                </li>
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="HistorialPagoes" asp-action="Index">Pagos</a>
                                </li>
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="Precios" asp-action="Index">Tarifas</a>
                                </li>
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="Dashboard" asp-action="Index">Reportes</a>
                                </li>
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="Reservas" asp-action="Index">Reservas</a>
                                </li>
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="Mensajes" asp-action="Index">Mensajes</a>
                                </li>
                            }
                            else if (User.IsInRole("Usuario"))
                            {
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="Reservas" asp-action="Index">Reservas</a>
                                </li>
                                <li class="nav-item" data-aos="fade-right">
                                    <a class="nav-link menu-link" asp-controller="Mensajes" asp-action="Index">Mensajes</a>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido principal -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="border-top footer bg-light mt-5">
        <div class="container py-3">
            &copy; @DateTime.Now.Year - Cementerio Parroquial San Agustín
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Efecto de scroll navbar
        <script>
            window.addEventListener('scroll', function() {
                const navbar = document.querySelector('.navbar');
                const logo = document.querySelector('.logo-img');

                if(window.scrollY > 50) {
                    navbar.classList.add('navbar-scrolled');
                    if(logo) logo.style.height = '60px';
                } else {
                    navbar.classList.remove('navbar-scrolled');
                    if(logo) logo.style.height = '70px';
                }
            });
        </script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- AOS JS -->
        
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 1000,
            once: true
        });
    </script>

    
    </body>
    </html>
